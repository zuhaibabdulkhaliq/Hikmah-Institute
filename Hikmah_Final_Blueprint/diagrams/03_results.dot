digraph g {
 graph [rankdir=TB, splines=ortho, bgcolor=white, pad="0.22", nodesep="0.44", ranksep="0.80", fontsize=18, label="Exam Papers, 100-Mark Groups + Immutable Results", labelloc=t, fontname="DejaVu Sans", fontcolor="#152947"];
 node [shape=record, style="rounded,filled", color="#b1c8de", penwidth=1.3, fillcolor="#f1f6fc", fontname="DejaVu Sans", fontsize=10, margin="0.12,0.08"];
 edge [color="#5b7697", arrowsize=0.62];
 cycle [label="{exam_cycles|id PK|academic_year_id FK}"];
 section [label="{sections|id PK}"];
 paper [fillcolor="#dceeff",label="{exam_assessments|id PK|cycle_id FK|section_subject_id FK|max_marks|display_order}"];
 timetable [label="{exam_schedule_entries|assessment_id FK|date/time/pattern}"];
 grp [fillcolor="#dceeff",label="{result_groups|id PK|cycle_id FK|section_id FK|target_max 100}"];
 comp [label="{result_group_components|group_id FK|assessment_id FK|contribution_max}"];
 mark [label="{marks|assessment_id FK|enrollment_id FK|status + nullable awarded}"];
 scheme [label="{exam_scheme_approvals|cycle_id FK|section_id FK|revision+snapshot}"];
 run [fillcolor="#e6f6ee",label="{result_runs|cycle_id FK|section_id FK|revision|PUBLISHED/SUPERSEDED}"];
 snap [fillcolor="#e6f6ee",label="{result_snapshots|run_id FK|enrollment_id FK|total/%/attendance/grade}"];
 lines [label="{result_snapshot_groups|snapshot_id FK|group awarded/possible}"];
 papers [label="{result_snapshot_papers|snapshot_id FK|paper score/status/max}"];
 pdf [label="{document_exports|run_id FK|file_key / sha256}"];
 grade [label="{grade_scales / grade_bands|approved thresholds}"];
 rank [label="{ranking_policies|approved tie/top-N}"];
 cycle -> {paper grp scheme run};section -> {grp scheme run};paper -> {timetable comp mark};grp -> comp;
 scheme -> run;grade -> run; rank -> run;run -> {snap pdf};snap -> {lines papers};
}
