# Copy to .env.production, chmod 600, and replace every example value.
SITE_HOST=school.example.org
PUBLIC_ORIGIN=https://school.example.org
BETTER_AUTH_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Use distinct provider users; URL-encode passwords. TLS must verify certificates.
DATABASE_URL=postgresql://hikmah_app:REPLACE@db.example.org/hikmah?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://hikmah_migrator:REPLACE@db.example.org/hikmah?sslmode=verify-full
